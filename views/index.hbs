

    <!-- header section starts  -->

    <header>
        {{>header}}

    </header>

    <!-- header section ends -->

    <!-- home section starts  -->

    <section class="home" id="home">

        <div class="image">
            <img src="img/home-img.png" alt="">
        </div>

        <div class="content">
            <span>fresh and organic</span>
            <h3>your daily need products</h3>
            <a href="/product" class="btn">get started</a>
        </div>

    </section>

    <!-- home section ends -->

    <!-- banner section starts  -->

    <section class="banner-container">

        <div class="banner">
            <img src="img/banner-1.jpg" alt="">
            <div class="content">
                <h3>special offer</h3>
                <p>upto 45% off</p>
                <a href="#" class="btn">check out</a>
            </div>
        </div>

        <div class="banner">
            <img src="img/banner-2.jpg" alt="">
            <div class="content">
                <h3>limited offer</h3>
                <p>upto 50% off</p>
                <a href="#" class="btn">check out</a>
            </div>
        </div>

    </section>

    <!-- banner section ends -->

    <!-- category section starts  -->

    <section class="category" id="category">

        <h1 class="heading">shop by <span>category</span></h1>

        <div class="box-container">

            <div class="box">
                <h3>vegitables</h3>
                <p>upto 50% off</p>
                <img src="img/category-1.png" alt="">
                <a href="#" class="btn">shop now</a>
            </div>
            <div class="box">
                <h3>fruite</h3>
                <p>upto 12% off</p>
                <img src="img/category-4.png" alt="">
                <a href="#" class="btn">shop now</a>
            </div>

        </div>

    </section>

    <!-- category section ends -->

    <!-- product section starts  -->

    <section class="product" id="product">

        <h1 class="heading">latest <span>products</span></h1>

        <div class="box-container">
            {{#each produvtList}}
                {{#if available}}
                    <div class="box">
                        <div class="inner-box" onclick="location.href='/productdetails?id='+'{{id}}'" >
                            <span class="discount">-33%</span>
                            <div class="icons">
                                <a href="#" class="fas fa-heart"></a>
                                <a href="#" class="fas fa-share"></a>
                                <a href="#" class="fas fa-eye"></a>
                            </div>
                            <img src={{fileID}} alt="">
                            <h3>{{name}}</h3>
                            <div class="stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <div class="price"> Rs.{{price}}<span> Rs.{{price}}+20 </span> </div>
                        </div>
                        <div class="quantity">
                            {{!-- <span>quantity : </span><br> --}}
                            <button onclick=quantity('{{id}}','-') class="inc_dec_button">-</button>
                            <input  id="no_of_item{{id}}" class="comman" value="1" size="1px" readonly >
                            <button onclick=quantity('{{id}}','+') class="inc_dec_button">+</button><br><br>
                            <span> /kg </span>
                            <br>
                        </div>
                        <a class="btn" id="cart{{id}}" onclick="aad_to_cart('{{id}}')">add to cart</a>
                    </div>
                {{/if}}
            {{/each}}
        </div>
    </section>

    <!-- product section ends -->

    <!-- deal section starts  -->

    <section class="deal" id="deal">

        <div class="content">

            <h3 class="title">deal of the day</h3>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Veniam possimus voluptates commodi laudantium!
                Doloribus sint voluptatibus quaerat sequi suscipit nulla?</p>

            <div class="count-down">
                <div class="box">
                    <h3 id="day">00</h3>
                    <span>day</span>
                </div>
                <div class="box">
                    <h3 id="hour">00</h3>
                    <span>hour</span>
                </div>
                <div class="box">
                    <h3 id="minute">00</h3>
                    <span>minute</span>
                </div>
                <div class="box">
                    <h3 id="second">00</h3>
                    <span>second</span>
                </div>
            </div>

            <a href="#" class="btn">check the deal</a>

        </div>

    </section>

    <!-- deal section ends -->


    <!-- newsletter section starts  -->

    <section class="newsletter">

        <h3>start shopping now </h3>

        <form action="">
            <input class="box" type="email" placeholder="send your email">
            <input type="submit" value=" Shop Now" class="btn">
        </form>

    </section>

    <!-- newsletter section ends -->

    <!-- footer section starts  -->

    <footer class="footer">
        {{>footer}}
    </footer>
    <!-- footer section ends -->



















    <!-- custom js file link  -->
    <script type="text/javascript" src="js/script.js"></script>

</body>

</html>