

    <!-- header section starts  -->

    <header>
        {{>header}}
    </header>

    <!-- header section ends -->

    <!-- home section starts  -->
    <h1>
        payment=={{payment}}
        name=={{name}}
        key=={{key}}

    </h1>
    <h3>Welcome to Payment Gateway</h3>
    <form action="payment" method="POST">
        
        <script
            src="https://checkout.stripe.com/checkout.js"
            class="stripe-button"
            data-key={{key}}
            data-amount={{payment}}
            data-currency="usd"
            data-name={{name}}
            data-description="secure payment"
            data-locale="auto" >
        </script>
    </form>
    
<footer class="footer">
        {{>footer}}
    </footer>
    <!-- footer section ends -->
    <!-- custom js file link  -->
      
    <script src="js/script.js"></>
</body>
</html>