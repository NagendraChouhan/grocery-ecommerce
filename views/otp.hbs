<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="css/Index.css"/> --}}
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/responsive.css">
    <link rel="stylesheet" href="css/login.css">
</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    <div class="login-div-main">
    <h1>OTP</h1>

		<form method="post" action="/otp">		 
			<div class="container">
                <input type="text" placeholder="Enter email" name="email" required {{#if username}} value="{{username}}"{{/if}} readonly><br>
				<span style="color:red" class="pass_class"></span><br>
				<input type="number" placeholder="Enter OTP" name="otp" required><br>

                <div class="validation-error" {{#if otperr}} style="display: inline-block;"{{/if}}>
                    {{ otperr }}
                </div><br>
				<button type="submit">Verify</button><br>
                <span class="foget-psw">Change <a href="#">Email</a></span>
			</div>
		</form>
    </div>
</body>
</html>