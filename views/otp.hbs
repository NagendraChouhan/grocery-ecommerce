<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="css/Index.css"/> --}}
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/responsive.css">
    <link rel="stylesheet" href="css/login.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    <div class="login-div-main">
    <h1>{{nameotp}}</h1>
        {{#if updatePass}}
        <form id="updatepasswordform">		 
			<div class="container">
                <input type="email" name="email" placeholder="Enter Email" {{#if email}} value={{email}}{{/if}}> <br> 
                <input type="password" name="pass" placeholder="Enter password" {{#if password}} value={{password}}{{/if}}> <br> 
                <div style="text-align:center; padding-left:10px; font-size:14px;">
                    <span class="pass_class">Password must contain:<br/>minimum Length of 8 charecter<br/>minimum 1 Lowercase and Uppercase leter <br/>minimum 1 Numbers <br/>minimum 1 special Symbols(@,#.$,etc)</span></br>
                </div>
                <input type="password" name="rPass" placeholder="Reenter Password" {{#if repassword}} value={{repassword}}{{/if}}><br>
                <span style="color:red" id="repass"></span>
                <div class="validation-error" {{#if changepasserr}} style="display: inline-block;"{{/if}}>
                    {{ changepasserr }}
                </div><br>
				<button type="submit">Change</button><br>
			</div>
		</form>
            
        {{else}}


		<form method="post" {{#if updatePassotp}} action="/chechupdatepassotp" {{/if}} {{#if otpVisible}}action="/forgotPassword" {{else}} action="/otp" {{/if}}  >		 
			<div class="container">
                <input type="text" placeholder="Enter email" name="email" required {{#if username}} value="{{username}}"{{/if}} {{#if otpVisible}} {{else}} readonly {{/if}}  ><br>
				<span style="color:red" class="pass_class"></span><br>
                {{#if otpVisible}} {{else}}<input type="number" placeholder="Enter OTP"  name="otp" required><br>{{/if}}
				

                <div class="validation-error" {{#if otperr}} style="display: inline-block;"{{/if}}>
                    {{ otperr }}
                </div><br>
				<button type="submit">Verify</button><br>
			</div>
		</form>
        {{/if}}
    </div>

    
    <footer class="footer">
        {{>footer}}
    </footer>
    <!-- custom js file link  -->
    <script>
        var url = "https://reqbin.com/echo/patch/json";
        console.log("inside script of ajax");
        var xhr = new XMLHttpRequest();
        xhr.open("PATCH", url);

        xhr.setRequestHeader("Accept", "application/json");
        xhr.setRequestHeader("Content-Type", "application/json");

        xhr.onreadystatechange = function () {
        if (xhr.readyState === 4) {
            console.log(xhr.status);
            console.log(xhr.responseText);
        }};

        var data = `{
        "Id": 12345,
        "Customer": "John Smith",
        "Quantity": 1,
        "Price": 10.00
        }`;

        xhr.send(data);

        
        $(document).ready(function(){
            console.log("inside ajax");
            $('#updatepasswordform').on('submit',function(event){
                event.preventDefault();
                const formdata=$(this).serialize();
                console.log("formdata=="+formdata);

                $.ajax({
                    url: '/updatepassword',
                    method: 'patch',
                    data: formdata,
                    success: function (result, status, xhr){
                        console.log('successful.....');
                    },
                    error: function(xhr, status, error){
                        console.log('error from updatepasswordform==='+error);
                    }
                })
            })
        })
    </script>
    <script type="text/javascript" src="js/script.js"></script>
</body>
</html>