<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>complete responsive GrosoMART Website</title>

    <!-- font awesome cdn link  -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <!-- custom css file link  -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/login.css">

</head>

<body>

    <!-- header section starts  -->

    <header>
        {{>header}}
        

    </header>

    <!-- header section ends -->

    <!-- profile section starts  -->

     <section class="product" id="product" style="padding: 1% 1% 5% 0%; background-color: #eeeeee24;">

        <h1 class="heading"><span>{{data.name}}</span></h1>
        <button class="openbtn menu-position" id="openmenubtn" onclick="openmenu()">☰ Menu</button>  
        <menu class="dashboard-menu menu-position" id="leftsidemenu" style="width:0px; bottom: 25%;">
            <button class="openbtn closebtn" style="text-align: right;" onclick="closemenu()">×</button>  
            <div class="dashboard-option" onclick="profile()">Profile</div>
            <div class="dashboard-option" onclick="orders()">Orders</div>
            <div class="dashboard-option" onclick="address()">Address</div>
            <div class="dashboard-option" id="Logout" onclick="location.href='#'">Logout</div>
        </menu>
        <div style="margin: 1% 1% 1% 8%; background-color: white; padding: 2% 0% 5% 8%;">
            <div id="profile">
                <h1 style="font-size: x-large; line-height: 2.2;">My Details</h1>
                <h2>Personal Information</h2><hr>
                <form method="post" action="/login">                
                    <div class="container" style="text-align: left; margin-left:15%;">
                        <label>Name {{data.name}}</label><br/>
                        <input type="text" placeholder="Enter Name" name="name" required {{#if data.name}} value="{{data.name}}"{{/if}}><br>
                        <label>Mobile Number</label><br/>
                        <input type="number" placeholder="Enter Mobile Number" name="phoneNo" required {{#if data.phone}} value={{data.phone}}{{/if}}><br>
                        <label>DOB</label><br/>
                        <input type="date" name="dob">
                        <span style="color:red" class="pass_class"></span><br>
                        <button type="submit" >Save</button><br>
                    </div>
                </form>

                <h2>E-mail Address Information</h2><hr>
                <form method="post" action="/login">                
                    <div class="container" style="text-align: left; margin-left:15%;">
                        <label>Email</label><br/>
                        <input type="email" readonly {{#if data.email}} value={{data.email}}{{/if}}><br>
                    </div>
                </form>

                <h2>Password update</h2><hr>
                <form method="post" action="/login">                
                    <div class="container" style="text-align: left; margin-left:15%;">
                        <label>Current Password</label><br/>
                        <input type="password" placeholder="Enter Current Password" name="password" required ><br>
                        <label>New Password</label><br/>
                        <input type="password" placeholder="Enter Current Password" name="password" required ><br>
                        <label>Reenter New Password</label><br/>
                        <input type="password" placeholder="Enter Current Password" name="password" required ><br>
                        <span style="color:red" class="pass_class"></span><br>
                        <button type="submit" >Save</button><br>
                    </div>
                </form>
            </div>

            <div id="Orders" style="display: none;">
                <h1 style="font-size: x-large; line-height: 2.2;">Orders</h1>
                <h3>Total Item</h3><hr>
                <div>
                    <div>
                        <span>Orders Name</span>
                        <span>Orders Status</span>  
                        <span>Orders Img</span>  
                    </div>
                </div>

            </div>
            <div id="Address" style="display: none;">
                {{>addresspartial}}
            </div>
        </div>
    </section>


    <!-- profile section end  -->


    <!-- footer section starts  -->

    <footer class="footer">
        {{>footer}}
    </footer>
    <!-- footer section ends -->

    <!-- custom js file link  -->
    <script>
        var selectaddbtn=document.getElementsByClassName("selectaddbtn");
        for(let i=0;i<selectaddbtn.length;i++){
            console.log(selectaddbtn[i]);
            selectaddbtn[i].style.display = "none"
        }

        selectaddbtn
        function openmenu() {
        document.getElementById("leftsidemenu").style.width = "225px";
        document.getElementById("openmenubtn").style.display="none";
        }

        function closemenu() {
        document.getElementById("leftsidemenu").style.width = "0";
        document.getElementById("openmenubtn").style.display="block";
        }

        function profile(){
            document.getElementById("Orders").style.display= "none";
            document.getElementById("Address").style.display = "none";
            document.getElementById("profile").style.display = "block";
            window.scrollTo(0, 0);          
            closemenu();
        }
        function orders(){
            document.getElementById("profile").style.display= "none";
            document.getElementById("Address").style.display = "none";
            document.getElementById("Orders").style.display= "block";
            window.scrollTo(0, 0);          
            closemenu();

        }
        function address(){
            document.getElementById("profile").style.display= "none";
            document.getElementById("Orders").style.display = "none";
            document.getElementById("Address").style.display = "block";
            window.scrollTo(0, 0);        
            closemenu();

        }
    </script>
    <script type="text/javascript" src="js/script.js"></script>

</body>

</html>



