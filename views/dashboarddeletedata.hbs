
    <header id="header" >
        {{>header}}        
    </header>
    {{>dashboardmenu}}
    <div class="dashboard-div-main App-div-main">
        <h2>Dashboard</h2>
        <div >
            <table class="dashboard-table" style="overflow-x:scroll ;">
                <thead>
                    <tr>
                        <th>SNo.</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>FileID</th>
                        <th>decription</th>
                        <th>select</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productlist}}
                        <tr>
                            <form  autocomplete="on" action="/dashboard/addproduct" name="persanalform" method="post" style="overflow:auto ;">
                                    <td class="sn"></td>
                                    <td><input style="width:120px;" type="text" name="id" readonly value={{id}}></td>
                                    <td><input style="width:120px;" type="text" name="name" readonly value="{{name}}"></td>
                                    <td><input style="width:120px;" type="number" name="price" readonly value={{price}}></td>
                                    <td><input style="width:120px;" type="text" name="image" readonly value={{fileID}}></td>
                                    <td><textarea style="width:120px;" name="decription" readonly cols="10" rows="1">{{decription}}</textarea><br></td>
                                    {{!-- <td><input type="text" name="date" readonly value={{date}}></td> --}}
                                    <td><label><input type="checkbox" name="deletecheckbox" class="checkboxoption">Delete</label></td>
                                    <td><button type="submit" class="checkboxButton" disabled>Delete</td>
                            </form>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="../js/script.js"></script>
</body>
</html>