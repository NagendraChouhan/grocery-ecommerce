<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="../css/Index.css"/> --}}
    <link rel="stylesheet" href="../css/style.css"/>
    <link rel="stylesheet" href="../css/responsive.css">
    {{!-- <link rel="stylesheet" href="../css/dashboard.css"> --}}
    <link rel="stylesheet" href="../css/login.css">
</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    <div class="singup-div-main">
        <div class="singup-div">
            <h1><b>Singup</b></h1><br/>
            
            <form  autocomplete="on" {{#if adminloginValue}} action="/dashboard/singup" {{/if}} action="/singup" name="persanalform" method="post" style="overflow:auto;">
                <fieldset id="f1">
                    <div class="singup-inner-div">
                        <img class="singup-img" src="img/logo.jpg" alt="mandsaur_pharmacy" height="100px" border="1px"><br>
                        <table align="center" cellpadding="5px" cellspacing="5px">
                            <tr>
                                <td id="name"><input type="text" name="name" placeholder="Enter Full Name" pattern="^[a-z A-Z]+$" title="Only use ALPHABETS" autofocus required ><br>
                                <span style="color:red" class="pass_class"></span></td></td>
                            </tr>
                            <tr>
                                <td><input type="email" name="username" placeholder="Enter Email" required><br>
                                <span style="color:red" class="pass_class"></span></td>
                            </tr>
                            <tr>
                                <td><input type="password" name="pass" placeholder="Enter password"  required> <br> 
                                <span style="color:red" class="pass_class"></span></td>
                                
                            </tr>
                            <tr>
                                <td><input type="password" name="rPass" placeholder="Reenter Password" required><br>
                                <span style="color:red" id="repass"></span></td>
                            </tr>
                            <tr>
                                <td><input type="tel" name="phoneNo" placeholder="Enter Number" pattern="[0-9]{10}" required><br>
                                <span style="color:red" class="pass_class">Only enter Number of 10 digit</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <label><input type="radio" value="Male" name="gender" checked >Male</label>
                                    <label><input type="radio" value="Female" name="gender">Female</label>
                                    <label><input type="radio" value="Other" name="gender">Other</label>
                                </td>
                            </tr>
                            <tr>
                                <td><input type="date"  name="dob" min="1900-01-01" required><br>
                                <span style="color:red" class="pass_class"></span></td>
                            </tr>
                            {{#if adminloginValue}}
                                <tr>
                                    <td>
                                    <label><input type="radio" value="admin" name="type" checked>Admin</label>
                                    <label><input type="radio" value="employee" name="type">Employee</label>
                                </td>
                                </tr>
                            {{/if}}
                            <tr>
                                <td><button type="submit">submit</td>
                            </tr>
                        </table>
                    </div>	
                </fieldset>
            </form>
        </div>
    </div>
</body>
</html>