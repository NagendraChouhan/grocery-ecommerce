<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="css/Index.css"/> --}}
    <link rel="stylesheet" href="../css/style.css">
    <link rel="stylesheet" href="../css/responsive.css">
    <link rel="stylesheet" href="../css/dashboard.css">
    {{!-- <link rel="stylesheet" href="css/login.css"> --}}
</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    {{>dashboardmenu}}
    <div class="dashboard-div-main App-div-main">
        <h2>Dashboard</h2>
        <div >
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>SNo.</th>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone No.</th>
                        <th>DOB</th>
                        <th>gender</th>                        
                        <th>Date and Time</th>
                        <th>block</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each userList}}
                        <tr>
                            <form  autocomplete="on" action="/dashboard/addproduct" name="persanalform" method="post" style="overflow:auto ;">
                                <td class="sn"></td>
                                <td><input type="text" name="id" readonly value={{id}}></td>
                                <td>{{name}}</td>
                                <td>{{email}}</td>
                                <td>{{phone}}</td>
                                <td>{{dob}}</td>
                                <td>{{gender}}</td>
                                <td>{{date}}</td>
                                <td><label><input type="checkbox" {{#if block}} checked {{/if}} name="blockcheckbox" class="checkboxoption">Block Acc</label></td>
                                <td><button type="submit" class="checkboxButton" disabled>Block</td>
                            </form>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="../js/script.js"></script>
</body>
</html>