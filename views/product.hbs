<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>complete responsive GrosoMART Website</title>

    <!-- font awesome cdn link  -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <!-- custom css file link  -->
    <link rel="stylesheet" href="css/style.css">

</head>

<body>

    <!-- header section starts  -->

    <header>
        {{>header}}
    </header>

    <!-- header section ends -->

    <!-- home section starts  -->


    <section class="product" id="product">

        <h1 class="heading">latest <span>products</span></h1>
      
        <div class="box-container">
            {{#each userList}}
                {{#if available}}
                    <div class="box">
                        <div class="inner-box" onclick="location.href='/productdetails?id='+'{{id}}'" >
                            <span class="discount">-33%</span>
                            <div class="icons">
                                <a href="#" class="fas fa-heart"></a>
                                <a href="#" class="fas fa-share"></a>
                                <a href="#" class="fas fa-eye"></a>
                            </div>
                            <img src={{fileID}} alt="">
                            <h3>{{name}}</h3>
                            <div class="stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <div class="price"> Rs.{{price}}<span> Rs.{{price}}+20 </span> </div>
                        </div>
                        <div class="quantity">
                            {{!-- <span>quantity : </span><br> --}}
                            <button onclick=quantity('{{id}}','-') class="inc_dec_button">-</button>
                            <input  id="no_of_item{{id}}" class="comman" value="1" size="1px" readonly >
                            <button onclick=quantity('{{id}}','+') class="inc_dec_button">+</button><br><br>
                            <span> /kg </span>
                            <br>
                        </div>
                        <a class="btn" id="cart{{id}}" onclick="aad_to_cart('{{id}}')">add to cart</a>
                    </div>
                {{/if}}
            {{/each}}

    </section>
<footer class="footer">
        {{>footer}}
    </footer>
    <!-- footer section ends -->
    <!-- custom js file link  -->
      <script>
          var itemid;
            var cartbtn;
          var localstoragevalue;
           {{#each userList}}
                console.log('{{id}}');
                localstoragevalue=localStorage.getItem("{{id}}");
                if(localstoragevalue!=null ){
                    itemid=document.getElementById("no_of_item{{id}}");
                    cartbtn=document.getElementById("cart{{id}}");
                    console.log("itemid="+itemid.value);
                    console.log("localstoragevalue="+localstoragevalue);
                    itemid.value=localstoragevalue;
                    cartbtn.innerHTML="Go to Cart";
                    cartbtn.href = "/addtocart";
                }
            {{/each}}
            
        </script>
    <script src="js/script.js"></script>
</body>
</html>