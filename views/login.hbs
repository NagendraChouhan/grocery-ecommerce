
    <header id="header" >
        {{>header}}        
    </header>
    <div class="login-div-main">
    <h1>Login</h1>

		<form method="post" action="/login">
			<div class="imgcontainer">
				<img src="img/logo.jpg" alt="login-img" class="login-img">
			</div>
		 
			<div class="container">
                <input type="text" placeholder="Enter email" name="email" required {{#if username}} value={{username}}{{/if}}><br>
                <input type="password" placeholder="Password" name="password" required><br>
				<span style="color:red" class="pass_class"></span><br>
				<div class="validation-error" {{#if loginerr}} style="display: inline-block;"{{/if}}>
                    {{ loginerr }}
                </div><br>
				<button type="submit" >Log In</button><br>
                <a href="/signup"><button type="button" class="signupbtn" >Sign Up</button></a>
                <span class="foget-psw">Forgot <a href="/otp?forgotPassword=fg">password?</a></span>
			</div>
		</form>
    </div>

    <!-- custom js file link  -->
    <script type="text/javascript" src="js/script.js"></script>

</body>
</html>