
    <header id="header" >
        {{>header}}        
    </header>
    {{>dashboardmenu}}
    <div class="dashboard-div-main App-div-main">
        <h2>Dashboard</h2>
        <div >
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>SNo.</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>FileID</th>
                        <th>decription</th>
                        <th>Available</th>
                        <th>select</th>
                        <th>Update</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productlist}}
                        <tr>
                            <form  autocomplete="on" action="/dashboard/addproduct" name="persanalform" method="post" >
                                <fieldset id="f1">
                                    <div>
                                        <td class="sn"></td>
                                        <td id="name"><input type="text" name="id" readonly value={{id}}></td>
                                        <td><input type="text" name="name" placeholder="Enter Name" pattern="^[a-z A-Z]+$" title="Only use ALPHABETS" autofocus required value="{{name}}"></td>
                                        <td><input type="number" name="price" min="1" placeholder="Enter price" required value={{price}}></td>
                                        <td><input type="text" name="image" placeholder="Enter Image Link"  multiple required value={{fileID}}></td>
                                        <td><textarea name="decription" placeholder="Enter Decription" required cols="10" rows="1">{{decription}}</textarea><br></td>
                                        <td><label><input type="checkbox" {{#if available}}checked{{/if}} name="available">Available</label></td>
                                        <td><label><input type="checkbox" name="updatecheckbox" class="checkboxoption">Update</label></td>
                                        <td><button type="submit" class="checkboxButton" disabled>Update</td>
                                    </div>	
                                </fieldset>
                            </form>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="../js/script.js"></script>
    {{#if alert}} <script>alert("document updated")</script>{{/if}}
</body>
</html>
