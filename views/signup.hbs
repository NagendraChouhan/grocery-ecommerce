<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="../css/Index.css"/> --}}
    <link rel="stylesheet" href="../css/style.css"/>
    <link rel="stylesheet" href="../css/responsive.css">
    {{!-- <link rel="stylesheet" href="../css/dashboard.css"> --}}
    <link rel="stylesheet" href="../css/login.css">
</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    <div class="signup-div-main">
        <div class="signup-div">
            <h1><b>signup</b></h1><br/>
            
            <form  autocomplete="on" {{#if adminloginValue}} action="/dashboard/signup" {{/if}} action="/signup" name="persanalform" method="post" style="overflow:auto;">
                <fieldset id="f1">
                    <div class="signup-inner-div container">
                        <img class="signup-img" src="img/logo.jpg" alt="mandsaur_pharmacy" height="100px" border="1px"><br>
                        <table align="center" cellpadding="5px" cellspacing="5px">
                            <tr>
                                <td>
                                    <div class="validation-error" {{#if signuperror}} style="display: inline-block;"{{/if}}>
                                        {{ signuperror }}
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td id="name"><input type="text" name="name" placeholder="Enter Name" pattern="^[a-z A-Z]+$" title="Only use ALPHABETS" autofocus {{#if name}} value="{{name}}"{{/if}} ><br>
                                <span style="color:red" class="pass_class"></span></td></td>
                            </tr>
                            <tr>
                                <td><input type="email" name="username" placeholder="Enter Email" {{#if username}} value={{username}}{{/if}} ><br>
                                <span style="color:red" class="pass_class"></span></td>
                            </tr>
                            <tr>
                                <td><input type="password" name="pass" placeholder="Enter password" {{#if password}} value={{password}}{{/if}} > <br> 
                                <div style="text-align:left; padding-left:10px; font-size:14px;">
                                    <span class="pass_class">Password must contain:<br/>minimum Length of 8 charecter<br/>minimum 1 Lowercase and Uppercase leter <br/>minimum 1 Numbers <br/>minimum 1 special Symbols(@,#.$,etc)</span></td>
                                </div>
                                
                            </tr>
                            <tr>
                                <td><input type="password" name="rPass" placeholder="Reenter Password" {{#if repassword}} value={{repassword}}{{/if}}><br>
                                <span style="color:red" id="repass"></span></td>
                            </tr>
                            
                            {{#if adminloginValue}}
                                <tr>
                                    <td><input type="number" name="phoneNo" placeholder="Enter Number" {{#if phone}} value={{phone}}{{/if}}><br>
                                    <span style="color:red" class="pass_class"></span></td>
                                </tr>
                                <tr>
                                    <td>
                                    <label><input type="radio" value="admin" name="type" checked>Admin</label>
                                    <label><input type="radio" value="employee" name="type">Employee</label>
                                </td>
                                </tr>
                            {{/if}}
                            <tr>
                                <td><button type="submit">submit</td>
                            </tr>
                        </table>
                    </div>	
                </fieldset>
            </form>
        </div>
    </div>
    <!-- custom js file link  -->
    <script type="text/javascript" src="js/script.js"></script>
</body>
</html>