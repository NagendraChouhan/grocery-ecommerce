<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="../public/img/logo.jpg"/>
    {{!-- <link rel="stylesheet" href="css/Index.css"/> --}}
    <link rel="stylesheet" href="../css/style.css">
    <link rel="stylesheet" href="../css/responsive.css">
    <link rel="stylesheet" href="../css/dashboard.css">
    {{!-- <link rel="stylesheet" href="css/login.css"> --}}
</head>
<body>
    <header id="header" >
        {{>header}}        
    </header>
    {{>dashboardmenu}}
    <div class="dashboard-div-main App-div-main">
        <h2>Dashboard</h2>
        <div >
            <table class="dashboard-table" style="overflow-x:scroll ;">
                <thead>
                    <tr>
                        <th>SNo.</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>FileID</th>
                        <th>decription</th>
                        <th>Date And Time</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productlist}}
                        <tr>
                                <td class="sn"></td>
                                <td>{{id}}</td>
                                <td>{{name}}</td>
                                <td>{{price}}</td>
                                <td>{{fileID}}</td>
                                <td>{{decription}}</td>
                                <td>{{date}}</td>
                                <td><label><input type="checkbox" {{#if available}}checked{{/if}}>Available</label></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="../js/script.js"></script>
</body>
</html>