
    <header id="header" >
        {{>header}}        
    </header>
    {{>dashboardmenu}}
    <div class="dashboard-div-main App-div-main">
        <h2>Dashboard</h2>
        <div >
            <table class="dashboard-table" style="overflow-x:scroll ;">
                <thead>
                    <tr>
                        <th>SNo.</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>FileID</th>
                        <th>decription</th>
                        <th>Date And Time</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productlist}}
                        <tr>
                                <td class="sn"></td>
                                <td>{{id}}</td>
                                <td>{{name}}</td>
                                <td>{{price}}</td>
                                <td>{{fileID}}</td>
                                <td>{{decription}}</td>
                                <td>{{date}}</td>
                                <td><label><input type="checkbox" {{#if available}}checked{{/if}}>Available</label></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="../js/script.js"></script>
</body>
</html>