    <!-- custom js file link  -->
    <script>
        //window.location.href = "/address";
        function addaddress(id){
            console.log("click");
            console.log("id="+id);
            document.getElementById('AddressTable').scrollIntoView();
            
            var aformid=document.getElementById("formid");
            aformid.setAttribute("action","/address?id="+id+"&amount="+{{payment}});
            document.getElementById("addsubbtn").innerHTML="Pay";

            var country=document.getElementsByName("country")[0];
            var state=document.getElementsByName("state")[0];
            var district=document.getElementsByName("district")[0];
            var tehsil=document.getElementsByName("tehsil")[0];
            var houseNo=document.getElementsByName("houseNo")[0];
            var colony=document.getElementsByName("colony")[0];
            var landmark=document.getElementsByName("landmark")[0];
            var pinCode=document.getElementsByName("pinCode")[0];

            var countryId=document.getElementById(id+"country");
            var stateId=document.getElementById(id+"state");
            var districtId=document.getElementById(id+"district");
            var tehsilId=document.getElementById(id+"tehsil");
            var houseNoId=document.getElementById(id+"houseNo");
            var colonyId=document.getElementById(id+"colony");
            var landmarkId=document.getElementById(id+"landmark");
            var pinCodeId=document.getElementById(id+"pinCode");

            country.value=countryId.innerHTML;
            state.value=stateId.innerHTML;
            district.value=districtId.innerHTML;
            tehsil.value=tehsilId.innerHTML;
            houseNo.value=houseNoId.innerHTML;
            colony.value=colonyId.innerHTML;
            landmark.value=landmarkId.innerHTML;
            pinCode.value=pinCodeId.innerHTML;
            //var url = new URLSearchParams(window.location.search);
            //var mainurl = url +'?'+id
            //window.open(mainurl,'_self')

        }
    </script>
    <script type="text/javascript" src="js/script.js"></script>

